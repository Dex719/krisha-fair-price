# FairPrice — переменные окружения.
# Скопируй в .env (он в .gitignore) или задай в настройках хостинга.
# ВСЕ переменные опциональны: без них приложение работает в базовом режиме
# (оценка по модели + сайт), соответствующие фичи просто выключаются.

# --- Telegram-бот ---------------------------------------------------------
# Токен от @BotFather. Без него бот выключен, сайт и API работают.
TELEGRAM_BOT_TOKEN=

# Публичный адрес приложения для регистрации webhook.
# На Hugging Face Spaces / Railway не нужен: SPACE_HOST / RAILWAY_PUBLIC_DOMAIN
# выставляются хостингом автоматически.
PUBLIC_BASE_URL=

# Базовый адрес Bot API (прокси, см. docs/tg-proxy-worker.js), если хостинг
# не выпускает запросы к api.telegram.org напрямую. По умолчанию https://api.telegram.org
TG_API_BASE=

# Личный чат владельца: еженедельная статистика, отчёты о переобучении.
TG_ADMIN_CHAT_ID=

# Канал для дайджеста «Топ-5 выгодных лотов дня» (@имя_канала или -100…),
# бот должен быть админом канала. Используется в GitHub Actions.
TG_CHANNEL_ID=

# --- LLM (Gemini) ---------------------------------------------------------
# Ключ Google AI Studio: анализ описаний (red flags), оценка ремонта по фото,
# оценка по вставленному тексту. Без ключа — мягкая деградация до кэша.
GEMINI_API_KEY=
# Модель Gemini (по умолчанию gemini-2.5-flash-lite — щадящий дневной лимит)
GEMINI_MODEL=

# --- Персистентность состояния (публичный репозиторий!) --------------------
# Токен GitHub с правом contents:write ТОЛЬКО на этот репозиторий
# (fine-grained PAT): подписки/слежка/статистика коммитятся в git, чтобы
# пережить редеплой. Без него состояние живёт до ближайшего рестарта.
GITHUB_PAT=

# Ключ шифрования subscriptions.json / tracked.json в публичном репо.
# Не задан — ключ выводится из TELEGRAM_BOT_TOKEN. ВАЖНО: при ротации токена
# бота без этой переменной старое состояние станет нечитаемым.
STATE_ENCRYPTION_KEY=

# Репозиторий для состояния и релиза базы (по умолчанию Dex719/krisha-fair-price)
GITHUB_REPO=

# --- База данных ----------------------------------------------------------
# URL сжатой базы (по умолчанию — GitHub Release db-latest этого репо)
KRISHA_DB_URL=
# 0 — не скачивать базу при старте (тесты/локальная разработка)
KRISHA_DB_AUTO=

# --- Сеть / rate-limit ----------------------------------------------------
# Сколько доверенных reverse-proxy стоят перед приложением. IP клиента для
# rate-limit берётся как этот-по-счёту элемент X-Forwarded-For СПРАВА (его
# вписывает доверенный прокси; левые элементы подделывает клиент). По
# умолчанию 1 — и HF Spaces, и Railway ставят перед uvicorn один роутер.
# 0 — приложение доступно напрямую, XFF не доверять. Больше 1 — если перед
# сервисом цепочка прокси (внешний LB + внутренний роутер).
TRUSTED_PROXY_HOPS=

# --- Скрейпинг ------------------------------------------------------------
# Диапазон вежливой паузы между запросами к krisha.kz, секунды (по умолчанию 2.0–4.0)
KRISHA_DELAY_MIN=
KRISHA_DELAY_MAX=
