# FairPrice — переменные окружения.
# Скопируй в .env (он в .gitignore) или задай в настройках хостинга.
# ВСЕ переменные опциональны: без них приложение работает в базовом режиме
# (оценка по модели + сайт), соответствующие фичи просто выключаются.

# --- Telegram-бот ---------------------------------------------------------
# Токен от @BotFather. Без него бот выключен, сайт и API работают.
TELEGRAM_BOT_TOKEN=

# Публичный адрес сайта: ссылки, sitemap/robots, кнопка «Открыть приложение».
# На Hugging Face Spaces / Railway без своего домена не нужен: SPACE_HOST /
# RAILWAY_PUBLIC_DOMAIN выставляются хостингом. Webhook бота регистрируется на
# адрес хостинга, а PUBLIC_BASE_URL — только когда его нет.
PUBLIC_BASE_URL=

# Базовый адрес Bot API (прокси, см. infra/tg-proxy-worker.js), если хостинг
# не выпускает запросы к api.telegram.org напрямую. По умолчанию https://api.telegram.org
TG_API_BASE=

# Лимиты бота на ОДИН чат (скользящее окно 60 с, считаются в памяти процесса).
# Писать боту может любой пользователь Telegram, а каждое сообщение чего-то
# стоит: ссылка — поход на krisha.kz с IP Space (серия 403 — бан), /track и
# /alerts_on — коммит в приватный репо данных (лимит GitHub API), текст от 40
# символов — живой вызов Gemini (дневная квота). Превысил — бот один раз за окно
# отвечает «подожди минуту», остальное молча игнорирует (в статистику не идёт).
# Числа — «на процесс»: при WEB_CONCURRENCY=2 фактический потолок на чат до 2x.
# Общий поток сообщений чата (по умолчанию 12 в минуту)
BOT_RATE_LIMIT_PER_MIN=
# Свободный текст, уходящий в Gemini (по умолчанию 3 в минуту). Повтор того же
# текста ещё и кэшируется на час, так что квоту он не тратит
BOT_TEXT_LIMIT_PER_MIN=
# Команды, пишущие состояние: /alerts_on, /alerts_off, /track, /untrack и
# deep-link /start track_… (по умолчанию 5 в минуту)
BOT_STATE_LIMIT_PER_MIN=

# Личный чат владельца: еженедельная статистика, отчёты о переобучении.
TG_ADMIN_CHAT_ID=

# Канал для дайджеста «Топ-5 выгодных лотов дня» (@имя_канала или -100…),
# бот должен быть админом канала. Используется в GitHub Actions.
TG_CHANNEL_ID=

# --- LLM (Gemini) ---------------------------------------------------------
# Ключ Google AI Studio: анализ описаний (red flags), оценка ремонта по фото,
# оценка по вставленному тексту. Без ключа — мягкая деградация до кэша.
GEMINI_API_KEY=
# Модель Gemini (по умолчанию gemini-2.5-flash-lite — щадящий дневной лимит)
GEMINI_MODEL=

# --- Приватный репозиторий данных -----------------------------------------
# Релизы db-latest / model-latest / snapshot-* и состояние бота (подписки,
# слежка, статистика, лог предиктов — data/*.json) живут в приватном репо,
# а не в публичном репо кода. По умолчанию Dex719/krisha-db.
KRISHA_DATA_REPO=
# Репо для состояния, если оно отдельно от данных (по умолчанию то же)
KRISHA_STATE_REPO=
# Fine-grained токен с Contents: read+write ТОЛЬКО на репо данных: приватные
# ассеты качаются через API, состояние коммитится туда же. Без него база,
# модель и состояние не загрузятся, а правки состояния живут до рестарта.
KRISHA_DB_TOKEN=
# 0 — не забирать состояние при старте (тесты/локальная разработка)
KRISHA_STATE_PULL=

# Ключ шифрования subscriptions.json / tracked.json. Не задан — выводится из
# TELEGRAM_BOT_TOKEN. ВАЖНО: при ротации токена бота без этой переменной
# старое состояние станет нечитаемым.
#
# Ключ = sha256("kfp-state:" + секрет), где секрет — STATE_ENCRYPTION_KEY, а
# если её нет — TELEGRAM_BOT_TOKEN. Поэтому токен ротируется безболезненно так:
#   1) задать STATE_ENCRYPTION_KEY равной ТЕКУЩЕМУ токену бота — и в секретах
#      Space, и в секретах GitHub Actions (секрет с тем же именем
#      STATE_ENCRYPTION_KEY). В Actions состояние читают два шага — «Alerts» в
#      rescrape.yml и «Track alerts (аренда)» в rescrape-rent.yml — и оба
#      прокидывают этот секрет в env. Пустой секрет ничего не меняет: ключ
#      тогда выводится из токена, как раньше. Секрет для ключа остаётся тем же,
#      ключ не меняется, состояние читается;
#   2) только после этого выпустить новый токен у @BotFather и подставить его в
#      TELEGRAM_BOT_TOKEN (Space и Actions) — webhook перерегистрируется сам.
# Обратный порядок (сначала новый токен) делает subscriptions.json и tracked.json
# нечитаемыми. Старый токен после шага 2 из STATE_ENCRYPTION_KEY убирать нельзя —
# это теперь и есть секрет ключа. (Тот же секрет солит хэши chat_id в статистике
# использования, так что и они не «переедут».)
# Оговорка: если токен меняют из-за компрометации (например, он утёк в логи),
# этот порядок шифрование от знающего СТАРЫЙ токен не восстанавливает — ключ
# остаётся производным от старого токена. Для такого случая нужна отдельная
# перешифровка состояния под новый секрет (прочитать старым ключом, записать
# новым); автоматического инструмента для неё нет.
STATE_ENCRYPTION_KEY=

# --- База данных и модели -------------------------------------------------
# Прямые ссылки вместо релиза (без токена) — локальная разработка/тесты
KRISHA_DB_URL=
KRISHA_MODEL_URL=
# 0 — не скачивать базу при старте (тесты/локальная разработка)
KRISHA_DB_AUTO=

# --- Сеть / rate-limit ----------------------------------------------------
# Сколько доверенных reverse-proxy стоят перед приложением. IP клиента для
# rate-limit берётся как этот-по-счёту элемент X-Forwarded-For СПРАВА (его
# вписывает доверенный прокси; левые элементы подделывает клиент). По
# умолчанию 1 — и HF Spaces, и Railway ставят перед uvicorn один роутер.
# 0 — приложение доступно напрямую, XFF не доверять. Больше 1 — если перед
# сервисом цепочка прокси (внешний LB + внутренний роутер).
TRUSTED_PROXY_HOPS=

# Общий секрет с Cloudflare Worker своего домена (infra/domain-worker.js).
# Воркер передаёт настоящий IP посетителя в X-Bagam-Client-IP вместе с этим
# ключом; без совпадения заголовок игнорируется. Пусто — домена нет.
PROXY_KEY=

# Сколько запросов с одного IP пропускаем за окно (по умолчанию 15 за 60 с).
# За общим NAT мобильного оператора под одним адресом сидит целый город:
# если при наплыве живые люди начнут ловить 429 — поднимай, рестарта хватит,
# пересобирать образ не нужно.
RATE_LIMIT_PER_WINDOW=
RATE_LIMIT_WINDOW_S=

# --- Кэши и воркеры (нагрузка) --------------------------------------------
# Процессов uvicorn. По умолчанию 2 (HF free tier — 2 vCPU); ~600 МБ памяти на
# процесс. 1 — прежнее поведение, если Space начнёт упираться в память.
WEB_CONCURRENCY=

# Сколько секунд /api/health отдаёт закэшированный ответ (по умолчанию 60).
# Внутри он читает базу и метрики модели, а зовут его все страницы при каждой
# загрузке плюс HEALTHCHECK контейнера.
HEALTH_CACHE_TTL_S=

# Сколько секунд держим готовый разбор объявления (по умолчанию 600). Главный
# смысл — пост в большом канале: тысяча человек вставляет одну ссылку, а на
# krisha.kz уходит один запрос.
PREDICT_CACHE_TTL_S=

# Как часто обновляется пул объявлений для кнопки «Показать на примере»
# (по умолчанию 600 секунд).
DEMO_POOL_TTL_S=

# Сколько держим отрицательный результат разбора — битая, удалённая или
# недоступная ссылка (по умолчанию 60 секунд). Короче позитивного кэша: лот
# могли вернуть. Без этого ссылка-битка в посте — самый дорогой путь: каждый
# посетитель заново гоняет полный скрейп с ретраями.
PREDICT_NEGATIVE_TTL_S=

# Сколько одновременных походов на krisha.kz разрешено одному процессу
# (по умолчанию 10) и сколько секунд запрос ждёт свободный слот, прежде чем
# получить 503 + Retry-After (по умолчанию 15). Лучше честно сказать «занято»,
# чем держать сотню висящих спиннеров.
PREDICT_SLOTS=
PREDICT_SLOT_WAIT_S=

# Полный бюджет запроса на пользовательский путь (веб/бот) в секундах: сколько
# ждём ВЕСЬ разбор, включая ожидание слота, прежде чем ответить 503
# (по умолчанию 20).
PREDICT_WAIT_S=

# Сетевой бюджет одного похода на krisha.kz для пользовательского пути:
# общий таймаут и таймаут соединения, секунды (по умолчанию 5 и 3). Краулерные
# 30 с здесь неуместны — при подвисшем апстриме два ретрая давали минуту на
# один запрос и намертво забивали слоты.
USER_SCRAPE_TIMEOUT_S=
USER_SCRAPE_CONNECT_S=

# Отдельный лимит для /api/demo (по умолчанию 120 за то же окно
# RATE_LIMIT_WINDOW_S). Демо дёргает каждая загрузка главной, а мобильный
# интернет в Казахстане — сплошной CGNAT: строгий лимит предикта резал бы
# живых людей на кнопке «Показать на примере». Счётчики бакетов раздельные.
DEMO_RATE_LIMIT_PER_WINDOW=

# --- Скрейпинг ------------------------------------------------------------
# Диапазон вежливой паузы между запросами к krisha.kz, секунды (по умолчанию 2.0–4.0)
KRISHA_DELAY_MIN=
KRISHA_DELAY_MAX=
