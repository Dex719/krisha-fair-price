# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Данные и артефакты (не коммитим — большие)
data/*.db
data/*.db-shm
data/*.db-wal
# файловая блокировка старта воркеров (см. _startup_lock в api/app.py)
data/.startup.lock
data/*.csv
# ревизия сборки: пишется воркфлоу деплоя прямо перед пушем снапшота в Space
data/build_revision.txt
data/rescrape_history_*.json
# состояние бота (подписки, слежка, статистика, лог предиктов) живёт в
# приватном репо данных — krisha.subscriptions.pull_state/save_json_state
data/*.json
# Веса модели и производные от данных артефакты живут в релизе model-latest
# приватного репо данных (krisha.db_release, issue #74) — рантайм и ретрейн
# качают их оттуда. В git остаются мета, история метрик, снапшот статистики
# и OSM/ЖК-справочники.
models/*.cbm
models/spatial_ref.json
models/model_gate_samples.json
models/rent/*.cbm
models/rent/spatial_ref.json
models/rent/model_gate_samples.json
# SHAP аренды — побочный продукт обучения, в README не используется
reports/shap_summary_rent.png

# reports/*.png — SHAP-график коммитим, он нужен README

# корневые базы от запусков не из корня проекта и локальные видео-проекты
/*.db
videos/
# рабочие заметки и отчёты аудитов — локально, в репозитории их нет
docs/

# но папки сохраняем
!data/.gitkeep
!models/.gitkeep
!reports/.gitkeep

